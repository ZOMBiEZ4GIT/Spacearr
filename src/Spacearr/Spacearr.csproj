<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Spacearr</RootNamespace>
    <AssemblyName>Spacearr</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spacearr.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <WebRoot>$(MSBuildProjectDirectory)/../../web</WebRoot>
  </PropertyGroup>
  <Target Name="BuildWeb" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(SkipWeb)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(WebRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(WebRoot)" />
  </Target>
  <Target Name="EnsureWebPlaceholder" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')">
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/wwwroot/index.html" Lines="&lt;!doctype html&gt;&lt;title&gt;Spacearr&lt;/title&gt;&lt;p&gt;Web app not built. Run npm run build in /web.&lt;/p&gt;" Overwrite="true" />
  </Target>
  <ItemGroup>
    <!-- The Web SDK already globs wwwroot/** into Content by default; Update (not
         Include) avoids MSBuild NETSDK1022 duplicate-item errors while still
         forcing PreserveNewest so a rebuilt SPA is copied to the output dir. -->
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
