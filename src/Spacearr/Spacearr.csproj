<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Spacearr</RootNamespace>
    <AssemblyName>Spacearr</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
    <!-- Pins to patched versions of transitive dependencies that a vulnerable-package
         scan flags at the versions EF Core 8.0.8 would otherwise pull in (all still
         within the .NET 8 line - see docs/launch-checklist.md). -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.20" />
    <PackageReference Include="System.Text.Json" Version="9.0.20" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spacearr.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <WebRoot>$(MSBuildProjectDirectory)/../../web</WebRoot>
  </PropertyGroup>
  <Target Name="BuildWeb" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(SkipWeb)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(WebRoot)" />
    <Exec Command="npm run build" WorkingDirectory="$(WebRoot)" />
  </Target>
  <Target Name="EnsureWebPlaceholder" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')">
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/wwwroot/index.html" Lines="&lt;!doctype html&gt;&lt;title&gt;Spacearr&lt;/title&gt;&lt;p&gt;Web app not built. Run npm run build in /web.&lt;/p&gt;" Overwrite="true" />
  </Target>
  <ItemGroup>
    <!-- The Web SDK already globs wwwroot/** into Content by default; Update (not
         Include) avoids MSBuild NETSDK1022 duplicate-item errors while still
         forcing PreserveNewest so a rebuilt SPA is copied to the output dir. This
         only covers files that already exist when the project is evaluated. -->
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Item globs like the one above are captured once, at project evaluation time,
       which happens before any target (including BuildWeb/EnsureWebPlaceholder) runs.
       On a fresh clone wwwroot doesn't exist yet at evaluation time, so those files
       would be silently missing from the Content set - and from the build/publish
       output - without this: re-glob wwwroot after it's been generated, but before
       AssignTargetPaths decides what gets copied/published. -->
  <Target Name="IncludeBuiltWeb" AfterTargets="BuildWeb;EnsureWebPlaceholder" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Include="wwwroot/**" Exclude="@(Content)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
